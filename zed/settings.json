// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  //
  // Few random convenient settings
  //
  "tab_size": 4,
  "agent_servers": {
    "mistral-vibe": {
      "default_config_options": {
        "mode": "lean",
        "thinking": "high",
        "model": "mistral-large-latest",
      },
      "type": "registry",
    },
    "claude-acp": {
      "default_config_options": {
        "model": "claude-fable-5[1m]",
        "mode": "default",
      },
      "type": "registry",
    },
    "opencode": {
      "favorite_config_option_values": {
        "model": [
          "mistral/mistral-medium-latest"
        ],
      },
      "default_config_options": {
        "mode": "build",
        "model": "mistral/mistral-medium-latest",
      },
      "type": "registry",
    },
  },
  "confirm_quit": true,
  "when_closing_with_no_tabs": "keep_window_open",
  "icon_theme": {
    "mode": "light",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme",
  },
  "base_keymap": "VSCode",
  "autosave": { "after_delay": { "milliseconds": 200 } },
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "auto_signature_help": false,
  "inline_code_actions": false,
  "auto_install_extensions": {
    "Catpuccin Icons": true,
  },
  "drag_and_drop_selection": {
    "enabled": false,
  },
  "seed_search_query_from_cursor": "selection",
  "current_line_highlight": "none",
  "scroll_beyond_last_line": "vertical_scroll_margin",

  //
  // Appearance
  //
  "hover_popover_enabled": false, // show it on a hotkey instead
  "hover_popover_delay": 1000,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark"
  },
  "buffer_font_size": 13,
  "buffer_font_family": "JetBrains Mono NL",
  "buffer_line_height": "standard",
  "inlay_hints": { "toggle_on_modifiers_press": { "control": true } }, // convenient to highlight types
  //
  // Bars
  //
  "title_bar": {
    "show_branch_name": true,
    "show_branch_status_icon": false,
    "show_project_items": true,
    "show_onboarding_banner": false,
    "show_user_menu": false,
    "show_user_picture": false,
    "show_sign_in": false,
    "show_menus": false,
  },

  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": true,
    "agent_review": true,
    "code_actions": false,
  },

  "outline_panel": {
    "button": false,
    "dock": "right",
    "indent_guides": {
      "show": "never",
    },
  },

  "scrollbar": {
    "show": "auto",
  },

  "git_panel": {
    "tree_view": true,
    "button": false,
    "dock": "right",
  },

  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false,
  },
  "status_bar": {
    "active_language_button": false,
    // "experimental.show": false
  },
  "collaboration_panel": { "dock": "right", "button": false },
  "project_panel": {
    "button": false,
    "dock": "right",
    "hide_root": true,
    "scrollbar": {
      "show": "never",
    },
    "indent_guides": {
      "show": "never",
    },
  },
  "diagnostics": { "button": true },
  "search": { "button": false },
  "terminal": {
    "detect_venv": "off",
    "button": false,
  },
  "debugger": { "button": false },
  "global_lsp_settings": { "button": false },

  "gutter": {
    "line_numbers": true,
    "runnables": false,
    "breakpoints": false,
    "folds": false,
    "bookmarks": false,
    "min_line_number_digits": 0,
  },
  "indent_guides": {
    "enabled": false,
  },

  //
  // LSPs
  //
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "rustc": {
          "source": "discover",
        },
        "check": {
          "command": "clippy",
        },
      },
    },
  },
  "languages": {
    "Python": {
      "language_servers": [
        "ruff",
        "ty",
        // "basedpyright"
      ],
    },
    "SQL": {
      "tab_size": 2,
    },
    "JSON": {
      "tab_size": 2,
    },
    "JSONC": { "tab_size": 2 },
    "YAML": {
      "tab_size": 2,
    },
    "Terraform": {
      "tab_size": 2,
    },
  },
  "edit_predictions": {
    "provider": "none",
    "disabled_globs": ["**"],
  },

  //
  // Agent
  //
  "agent": {
    "thinking_display": "always_collapsed",
    "default_model": {
      "provider": "ollama",
      "model": "devstral:latest",
      "enable_thinking": false,
    },
    "sidebar_side": "right",
    // "enabled": true,
    "enable_feedback": false,
    "dock": "right",
    "tool_permissions": {
      "tools": {
        "create_directory": {
          "default": "allow",
        },
      },
    },
    "button": false,
  },
}
